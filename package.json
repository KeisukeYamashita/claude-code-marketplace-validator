{
  "name": "claude-code-marketplace-validator",
  "version": "1.0.0",
  "description": "CLI tool to validate Claude Code Marketplace configuration files (marketplace.json)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "marketplace-validator": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "marketplace",
    "validator",
    "json",
    "schema"
  ],
  "author": "KeisukeYamashita",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.29.1"
}
